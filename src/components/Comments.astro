---
import { SITE, COMMENTS_ON } from '../config/site';
import { url } from '../lib/url';
const { slug, title } = Astro.props;
const prov = SITE.commentsProvider;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const targetId = prov === 'disqus' ? 'disqus_thread' : prov === 'commentbox' ? 'commentbox' : 'cusdis_thread';
const scriptSrc = prov === 'disqus' ? `https://${SITE.disqusShortname}.disqus.com/embed.js` : prov === 'commentbox' ? url('vendor/commentBox.min.js') : 'https://cusdis.com/js/cusdis.es.js';
const note = prov === 'disqus'
  ? 'Os comentários usam o Disqus. Você pode precisar entrar com uma conta Disqus ou comentar como visitante, se isso estiver habilitado.'
  : prov === 'commentbox' ? 'Não é preciso ter conta no GitHub. Os comentários são moderados pelo autor do site.'
  : 'Não é preciso ter conta. Os comentários passam por aprovação antes de aparecerem.';
---
{COMMENTS_ON && (
  <section class="comments" aria-labelledby="comentarios">
    <h2 id="comentarios">Comentários</h2>
    <p class="muted small">{note}</p>
    {prov === 'disqus' && <div id="disqus_thread"></div>}
    {prov === 'commentbox' && <div id="commentbox" class="commentbox"></div>}
    {prov === 'cusdis' && <div id="cusdis_thread" data-host="https://cusdis.com" data-app-id={SITE.cusdisAppId} data-page-id={slug} data-page-url={pageUrl} data-page-title={title} data-theme="light"></div>}
    <p id="cm-fallback" class="muted small" hidden>Os comentários estão indisponíveis no momento. Se quiser, escreva para <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
    <script is:inline define:vars={{ targetId, scriptSrc, prov, pid: SITE.commentboxId, pageUrl, slug, title }}>
      (function () {
        var t = document.getElementById(targetId); if (!t) return;
        var done = false;
        function fail() { var f = document.getElementById('cm-fallback'); if (f && !done && !t.children.length) f.hidden = false; }
        function load() {
          if (prov === 'disqus') window.disqus_config = function () { this.page.url = pageUrl; this.page.identifier = slug; this.page.title = title; };
          var s = document.createElement('script'); s.async = true; s.defer = true; s.src = scriptSrc;
          if (prov === 'disqus') s.setAttribute('data-timestamp', +new Date());
          s.onerror = fail;
          if (prov === 'commentbox') s.onload = function () { try { window.commentBox(pid, { className: 'commentbox', defaultBoxId: 'commentbox' }); done = true; } catch (e) { fail(); } };
          document.body.appendChild(s); setTimeout(function () { done = false; fail(); }, 10000);
        }
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (e, o) { if (e[0].isIntersecting) { o.disconnect(); load(); } }, { rootMargin: '300px' }).observe(t);
        } else load();
      })();
    </script>
  </section>
)}
